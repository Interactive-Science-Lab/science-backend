{
  "name": "homeschool-science-lab",
  "version": "1.0.0",
  "description": "Backend for the homeschool science lab",
  "main": "index.js",
  "scripts": {
    "server": "nodemon ./api/index.js",
    "start": "node ./api/index.js",
    "test": "cross-env NODE_ENV=testing jest --watch --verbose",
    "rollback": "knex migrate:rollback --knexfile=./data/knexfile.js",
    "migrate": "knex migrate:latest --knexfile=./data/knexfile.js",
    "seed": "knex seed:run --knexfile=./data/knexfile.js",
    "remote-rollback": "heroku run knex migrate:rollback --knexfile=./data/knexfile.js",
    "remote-migrate": "heroku run knex migrate:latest --knexfile=./data/knexfile.js",
    "remote-seed": "heroku run knex seed:run --knexfile=./data/knexfile.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Interactive-Science-Lab/science-backend.git"
  },
  "keywords": [],
  "author": "Jordan Hubbard",
  "bugs": {
    "url": "https://homeschoollabsonline.com"
  },
  "homepage": "https://homeschoollabsonline.com",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "datauri": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "jw-paginate": "^1.0.4",
    "knex-cleaner": "^1.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "owasp-password-strength-test": "^1.3.0",
    "supertest": "^7.0.0",
    "knex": "^3.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
